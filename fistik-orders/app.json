{
  "expo": {
    "name": "Fıstık Sipariş",
    "slug": "fistik-orders",
    "owner": "mirok1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "fistik-orders",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#C5D46A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.fistik.orders",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "kz.fistik.orders",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#C5D46A"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4A2C11",
          "defaultChannel": "orders",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aabf75fb-23f5-4ac9-99eb-6d2c5444527b"
      }
    }
  }
}
