{
  "name": "fistik-orders",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios --profile production --auto-submit --non-interactive",
    "build:ios:preview": "eas build --platform ios --profile preview --non-interactive",
    "submit:ios": "eas submit --platform ios --profile production --non-interactive",
    "whoami": "eas whoami"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.34",
    "expo-constants": "~57.0.25",
    "expo-device": "~57.0.2",
    "expo-notifications": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eas-cli": "^16.32.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": ["react-native"]
    }
  }
}
