    "build:ios:preview": "eas build --platform ios --profile preview --non-interactive",
    "submit:ios": "eas submit --platform ios --profile production --non-interactive",
    "whoami": "eas whoami"
  },
  "dependencies": {
    "expo": "~54.0.13",
    "expo-constants": "~18.0.9",
    "expo-device": "~8.0.9",
    "expo-notifications": "~0.32.12",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eas-cli": "^16.32.0",
    "typescript": "~5.9.2"
  }
}
